# ---------------------------------------------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------------------------------------------

# Database: PostgreSQL, locally and in production. Production example (Sydney region):
#   postgres://user:password@host:5432/q3?sslmode=require
# For a quick experiment without PostgreSQL, a SQLite file also works: DATABASE_URL=file:./q3.db
DATABASE_URL=postgres://q3:q3@localhost:5432/q3

# Long random string used to sign CMS logins. Generate one with:  openssl rand -hex 32
# Required: the app refuses to start without a value of at least 32 characters.
PAYLOAD_SECRET=

# Public address of the site, without a trailing slash. Used for canonical URLs, sitemap and structured data.
#   Production: https://www.q3tech.com/en-au   (or https://www.q3tech.com.au)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "production" only on the live site. Anything else tells search engines not to index (robots.txt).
SITE_ENV=development

# Bump on every deploy to refresh browser caches of /css and /js (or set it to the git commit SHA in CI).
NEXT_PUBLIC_ASSET_VERSION=1

# Optional: forward every enquiry to your CRM (HubSpot / Salesforce webhook, Zapier, Make …).
# Enquiries are always stored in the CMS under Leads → Form submissions as well.
CRM_WEBHOOK_URL=

# Optional in development, recommended in production: store uploaded images in S3 (Sydney) instead of on disk.
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For Cloudflare R2 or another S3-compatible store:
S3_ENDPOINT=

# Seed script only: the first admin account it creates.
SEED_ADMIN_EMAIL=admin@q3tech.com
# Leave empty to have the seed generate a random password and print it once.
SEED_ADMIN_PASSWORD=

# Email: enquiry alerts to the sales team and a thank-you email to the visitor. Without SMTP_HOST, nothing is sent
# (enquiries are still saved in the CMS). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail address,
# SMTP_PASS=a Google "App password" (https://myaccount.google.com/apppasswords), EMAIL_FROM=the same Gmail address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Who receives each enquiry (comma-separate several addresses).
LEADS_NOTIFY_TO=
# Shown in the thank-you email's sign-off; replies go there. Default: sales@q3tech.com
SALES_EMAIL=
# Set to "off" to stop the thank-you email to visitors.
LEADS_AUTOREPLY=
