    {
      "label": "About Q3",
      "html": "<section class=\"statement\" aria-label=\"About Q3\"><div class=\"wrap\">\n  <p data-statement><span class=\"w\">We</span> <span class=\"w\">solve</span> <span class=\"w\">complex</span> <span class=\"w\">business</span> <span class=\"w\">challenges</span> <span class=\"w\">with</span> <span class=\"w\">the</span> <span class=\"w\">right</span> <span class=\"w\">expertise,</span> <span class=\"w\">architecture,</span> <span class=\"w\">and</span> <span class=\"w\">approach.</span> <span class=\"w\">Our</span> <span class=\"w\">vendor-neutral</span> <span class=\"w\">philosophy</span> <span class=\"w\">ensures</span> <span class=\"w\">technology</span> <span class=\"w\">choices</span> <span class=\"w\">are</span> <span class=\"w\">driven</span> <span class=\"w\">by</span> <span class=\"w\">your</span> <span class=\"w\">business</span> <span class=\"w\">needs</span> <span class=\"w\">with</span> <span class=\"w\">a</span> <span class=\"w\">focus</span> <span class=\"w\">on</span> <span class=\"w\">engineering</span> <span class=\"w\">excellence,</span> <span class=\"w\">cost</span> <span class=\"w\">efficiency,</span> <span class=\"w\">and</span> <span class=\"w\">uncompromising</span> <span class=\"w\">quality.</span></p>\n  <div class=\"meta-row\">\n    <a class=\"btn btn-primary\" href=\"/about\">About Us <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a>\n    <a class=\"btn btn-outline\" href=\"/about\">How We Work Securely<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a>\n  </div>\n  <ul class=\"recstat-grid\" aria-label=\"Recognition and reviews\">\n    <li class=\"recstat\"><span class=\"recstat-badge\"><img decoding=\"async\" class=\"recstat-ico recstat-ico-img\" src=\"/assets/icons/recognition-default.svg\" alt=\"\" width=\"44\" height=\"44\" loading=\"lazy\"></span><span class=\"recstat-num\">25+ Years</span><span class=\"recstat-label\">of Industry Experience</span></li>\n    <li class=\"recstat\"><span class=\"recstat-badge\"><img decoding=\"async\" class=\"recstat-ico recstat-ico-img\" src=\"/assets/icons/recognition-default.svg\" alt=\"\" width=\"44\" height=\"44\" loading=\"lazy\"></span><span class=\"recstat-num\">8+ Years</span><span class=\"recstat-label\">Average Client Relationship</span></li>\n    <li class=\"recstat\"><span class=\"recstat-badge\"><img decoding=\"async\" class=\"recstat-ico recstat-ico-img\" src=\"/assets/icons/recognition-default.svg\" alt=\"\" width=\"44\" height=\"44\" loading=\"lazy\"></span><span class=\"recstat-num\">2,000+</span><span class=\"recstat-label\">Solutions Delivered</span></li>\n    <li class=\"recstat\"><span class=\"recstat-badge\"><img decoding=\"async\" class=\"recstat-ico recstat-ico-img\" src=\"/assets/icons/recognition-default.svg\" alt=\"\" width=\"44\" height=\"44\" loading=\"lazy\"></span><span class=\"recstat-num\">900+</span><span class=\"recstat-label\">Engineers and Specialists</span></li></ul>\n</div></section>",
      "blockName": "About Q3",
      "blockType": "htmlSection"
    },
    {
      "label": "Our Services",
      "html": "<section class=\"svc-wd\" aria-labelledby=\"svc-wd-title\"><div class=\"wrap\">\n  <div class=\"wd-head-row\"><h2 id=\"svc-wd-title\">Our Services</h2><a class=\"btn btn-outline wd-viewall\" href=\"/services\">View All <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n  <div class=\"wd-grid\">\n    <div class=\"wd-main\">\n      \n      <ol class=\"wd-list\" data-wd-list><li class=\"wd-item is-open\" data-wd>\n  <button class=\"wd-head\" type=\"button\" id=\"wd-h-0\" aria-expanded=\"true\" aria-controls=\"wd-p-0\">\n    <span class=\"wd-t\">AI Solutions Development</span><svg class=\"wd-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></button>\n  <div class=\"wd-panel\" id=\"wd-p-0\" role=\"region\" aria-labelledby=\"wd-h-0\"><div class=\"wd-in\">\n    <div class=\"wd-text\">\n      <p>As a leading AI solutions development company in Australia, we take agentic, generative and predictive AI from strategy through to production, built on your own data and existing systems.</p>\n      <a class=\"wd-link\" href=\"/services/ai-solutions-development\">Explore AI Services <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n    <ul class=\"wd-subs\">\n      <li><a href=\"https://www.q3tech.com/agentic-ai-development-services/\" rel=\"noopener\">Agentic AI Development</a></li>\n      <li><a href=\"https://www.q3tech.com/generative-ai-development-services/\" rel=\"noopener\">Generative AI</a></li>\n      <li><a href=\"https://www.q3tech.com/predictive-and-prescriptive-ai/\" rel=\"noopener\">Behavioural and Predictive Modelling</a></li>\n      <li><a href=\"https://www.q3tech.com/computer-vision/\" rel=\"noopener\">Computer Vision and Visual Intelligence</a></li>\n      <li><a href=\"https://www.q3tech.com/ai-strategy-consulting-services/\" rel=\"noopener\">AI Strategy and Consulting</a></li>\n    </ul>\n  </div></div>\n</li><li class=\"wd-item\" data-wd>\n  <button class=\"wd-head\" type=\"button\" id=\"wd-h-1\" aria-expanded=\"false\" aria-controls=\"wd-p-1\">\n    <span class=\"wd-t\">Custom Software Development</span><svg class=\"wd-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></button>\n  <div class=\"wd-panel\" id=\"wd-p-1\" role=\"region\" aria-labelledby=\"wd-h-1\"><div class=\"wd-in\">\n    <div class=\"wd-text\">\n      <p>We build custom web and mobile applications, SharePoint solutions, and cloud platforms, while modernising legacy systems through phased upgrades and DevOps to ensure seamless business continuity.</p><a class=\"wd-link\" href=\"/services/software-development\">Explore Software Development <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n    <ul class=\"wd-subs\">\n      <li><a href=\"/services/web-application-development\">Web Application Development</a></li>\n      <li><a href=\"/services/mobile-app-development-services\">Mobile App Development</a></li>\n      <li><a href=\"https://www.q3tech.com/sharepoint/\" rel=\"noopener\">SharePoint Development</a></li>\n      <li><a href=\"/services/software-development\">Legacy Application Modernisation</a></li>\n      <li><a href=\"/services/microsoft-solutions\">Cloud and DevOps Engineering</a></li>\n    </ul>\n  </div></div>\n</li><li class=\"wd-item\" data-wd>\n  <button class=\"wd-head\" type=\"button\" id=\"wd-h-2\" aria-expanded=\"false\" aria-controls=\"wd-p-2\"><span class=\"wd-t\">BI and Data Analytics</span><svg class=\"wd-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></button>\n  <div class=\"wd-panel\" id=\"wd-p-2\" role=\"region\" aria-labelledby=\"wd-h-2\"><div class=\"wd-in\">\n    <div class=\"wd-text\"><p>We unify your data on a governed platform that powers AI models, supported by data engineering and DataOps to deliver reliable reports and actionable dashboards for informed business decisions.</p><a class=\"wd-link\" href=\"/services/bi-and-data-analytics\">Explore Data and BI Services <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n    <ul class=\"wd-subs\"><li><a href=\"https://www.q3tech.com/dataops/\" rel=\"noopener\">DataOps</a></li><li><a href=\"https://www.q3tech.com/data-intelligence/\" rel=\"noopener\">Data Intelligence</a></li><li><a href=\"https://www.q3tech.com/business-intelligence/\" rel=\"noopener\">Business Intelligence</a></li><li><a href=\"https://www.q3tech.com/data-engineering/\" rel=\"noopener\">Data Engineering</a></li><li><a href=\"https://www.q3tech.com/reports-dashboard/\" rel=\"noopener\">Reports and Dashboards</a></li></ul>\n  </div></div>\n</li><li class=\"wd-item\" data-wd>\n  <button class=\"wd-head\" type=\"button\" id=\"wd-h-3\" aria-expanded=\"false\" aria-controls=\"wd-p-3\"><span class=\"wd-t\">Cybersecurity Services</span><svg class=\"wd-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></button>\n  <div class=\"wd-panel\" id=\"wd-p-3\" role=\"region\" aria-labelledby=\"wd-h-3\"><div class=\"wd-in\">\n    <div class=\"wd-text\"><p>We secure your enterprise software solutions, network, cloud and databases, and build security into delivery with DevSecOps from the first sprint. As an ISO 27001 certified team, we help you meet the controls auditors ask for.</p><a class=\"wd-link\" href=\"/services/cybersecurity-services\">Explore Security Services <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n    <ul class=\"wd-subs\"><li><a href=\"https://www.q3tech.com/devsecops/\" rel=\"noopener\">DevSecOps</a></li><li><a href=\"https://www.q3tech.com/application-security/\" rel=\"noopener\">Application Security</a></li><li><a href=\"https://www.q3tech.com/network-security/\" rel=\"noopener\">Network Security</a></li><li><a href=\"https://www.q3tech.com/cloud-security/\" rel=\"noopener\">Cloud Security</a></li><li><a href=\"https://www.q3tech.com/database-security/\" rel=\"noopener\">Database Security</a></li></ul>\n  </div></div>\n</li><li class=\"wd-item\" data-wd>\n  <button class=\"wd-head\" type=\"button\" id=\"wd-h-4\" aria-expanded=\"false\" aria-controls=\"wd-p-4\"><span class=\"wd-t\">Managed IT Services</span><svg class=\"wd-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></button>\n  <div class=\"wd-panel\" id=\"wd-p-4\" role=\"region\" aria-labelledby=\"wd-h-4\"><div class=\"wd-in\">\n    <div class=\"wd-text\"><p>We provide 24/7 IT support, remote infrastructure and cloud management, backed by defined service levels, IT consulting, and strategic planning.</p><a class=\"wd-link\" href=\"/services/managed-it-services\">Explore Managed IT <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n    <ul class=\"wd-subs\"><li><a href=\"https://www.q3tech.com/it-consulting-and-strategy-planning/\" rel=\"noopener\">IT Consulting and Strategy Planning</a></li><li><a href=\"https://www.q3tech.com/remote-infrastructure-management-services/\" rel=\"noopener\">Remote Infrastructure Management Services</a></li><li><a href=\"https://www.q3tech.com/cloud-infrastructure-services/\" rel=\"noopener\">Cloud Infrastructure Services</a></li><li><a href=\"https://www.q3tech.com/24-7-support-services/\" rel=\"noopener\">24x7 IT Support</a></li></ul>\n  </div></div>\n</li></ol>\n    </div>\n    <div class=\"wd-media\"><div class=\"wd-clip\"><img class=\"wd-img is-on\" data-wd-img=\"0\" src=\"/assets/images/appinv-svc-ai.webp\" alt=\"\" width=\"760\" height=\"1086\" loading=\"lazy\" decoding=\"async\"><img class=\"wd-img\" data-wd-img=\"1\" src=\"/assets/images/appinv-svc-software.webp\" alt=\"\" width=\"760\" height=\"1086\" loading=\"lazy\" decoding=\"async\"><img class=\"wd-img\" data-wd-img=\"2\" src=\"/assets/images/appinv-svc-data.webp\" alt=\"\" width=\"760\" height=\"1086\" loading=\"lazy\" decoding=\"async\"><img class=\"wd-img\" data-wd-img=\"3\" src=\"/assets/images/appinv-svc-security.webp\" alt=\"\" width=\"760\" height=\"1086\" loading=\"lazy\" decoding=\"async\"><img class=\"wd-img\" data-wd-img=\"4\" src=\"/assets/images/appinv-svc-managed.webp\" alt=\"\" width=\"760\" height=\"1086\" loading=\"lazy\" decoding=\"async\"></div></div>\n  </div>\n</div></section>",
      "blockName": "Our Services",
      "blockType": "htmlSection"
    },
