    {
      "label": "Enterprise IT Services, AI & Software Engineering Solutions",
      "html": "<section class=\"home-hero\" aria-labelledby=\"hero-title\">\n <div class=\"hero-card\">\n  <div class=\"hero-media\" aria-hidden=\"true\"><video autoplay muted loop playsinline preload=\"none\" poster=\"/assets/images/hero-poster.webp\" data-hero-video><source data-src=\"/assets/media/hero-video.webm\" type=\"video/webm; codecs=vp9\"><source data-src=\"/assets/media/hero-video.mp4\" type=\"video/mp4\"></video></div>\n  <div class=\"wrap\">\n    <ul class=\"hero-stats\" aria-label=\"Q3 at a glance\"><li><span class=\"pill-emoji\" aria-hidden=\"true\">☁️</span><strong>Salesforce</strong> Certified Partner</li><li><span class=\"pill-emoji\" aria-hidden=\"true\">🔒</span><strong>ISO 27001</strong> Certified</li><li><span class=\"pill-emoji\" aria-hidden=\"true\">🤝</span><strong>Microsoft</strong> Solutions Partner</li></ul>\n    <h1 id=\"hero-title\">Enterprise IT Services, AI & Software Engineering Solutions</h1>\n    <div class=\"hero-bottom\">\n      <p class=\"lede\">Backed by 25+ years of technical expertise, we bring together engineering excellence and strategic insight to architect, modernise, secure, and manage technology ecosystems that deliver lasting business value.</p>\n      <div class=\"actions\"><a class=\"btn btn-primary\" href=\"/services\" data-cta=\"hero_services\">Explore Our Services<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a><a class=\"btn btn-outline\" href=\"/contact\" data-cta=\"hero_contact\">Talk to Our Experts<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"/></svg></a></div>\n    </div>\n  </div>\n </div>\n</section>",
